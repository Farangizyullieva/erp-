# Ilova roli: superuser emas, BYPASSRLS yo'q, jadval egasi emas
DATABASE_URL=postgresql://educrm_app:educrm_app@localhost:5432/educrm
# Migration'lar va seed uchun (jadval egasi)
DATABASE_MIGRATE_URL=postgresql://educrm_owner:educrm_owner@localhost:5432/educrm
REDIS_URL=redis://localhost:6379
PORT=3001
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
DEFAULT_TENANT_SLUG=najot-talim
CORS_ORIGIN=http://localhost:3000
# Faqat seed uchun
SEED_OWNER_PHONE=+998900000000
SEED_OWNER_PASSWORD=clear

# Maxfiy maydonlarni (TOTP kaliti) shifrlash kaliti: 32 bayt, hex — `openssl rand -hex 32`
SECRETS_ENC_KEY=

# Telegram bot tokeni (@BotFather dan olinadi). Bo'sh bo'lsa Telegram xabarlari o'chiq turadi
TELEGRAM_BOT_TOKEN=

# Xato va muhim hodisalar boti (@BotFather). ALERT_LINK_CODE — botga ulanish uchun maxfiy kod (`openssl rand -hex 16`):
# t.me/<bot>?start=<kod> havolasini ochgan odam xabarlarni oladi
ERROR_TELEGRAM_BOT_TOKEN=
ALERT_LINK_CODE=


# Yuklangan fayllar papkasi (lokal) va rasmlar havolasi uchun API'ning tashqi manzili
UPLOAD_DIR=uploads
PUBLIC_API_URL=http://localhost:3001/api/v1
